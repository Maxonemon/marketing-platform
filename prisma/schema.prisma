// Prisma 7: the connection URL lives in prisma.config.ts, and the client connects through @prisma/adapter-pg.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

// User, Session, Account and Verification follow Better Auth's core schema (better-auth 1.7).

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions         Session[]
  accounts         Account[]
  memberships      WorkspaceMember[]
  activity         ActivityLogEntry[]
  requestedTasks   Task[]
  proposedActions  ProposedAction[]
  decidedApprovals Approval[]
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members         WorkspaceMember[]
  brands          Brand[]
  tasks           Task[]
  proposedActions ProposedAction[]
  activity        ActivityLogEntry[]
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Brand {
  id                  String   @id @default(cuid())
  workspaceId         String
  name                String
  websiteUrl          String?
  industry            String?
  audience            String?
  voice               String?
  // The content agent uses the offers and keywords; the rules are checked on each Variant
  // (src/lib/brand-rules.ts).
  offers              String[] @default([])
  keywords            String[] @default([])
  prohibitedPhrases   String[] @default([])
  requiredDisclaimers String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  workspace       Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks           Task[]
  proposedActions ProposedAction[]
  activity        ActivityLogEntry[]

  @@index([workspaceId])
}

enum TaskType {
  CONTENT_GENERATION
}

// A Task becomes COMPLETED when its Review is submitted or discarded (ticket 04).
enum TaskStatus {
  QUEUED
  RUNNING
  IN_REVIEW
  COMPLETED
  FAILED
  CANCELLED
}

// One run of one agent. `input` holds what was asked for; src/lib/app/tasks.ts parses
// it. startedAt/finishedAt bound the agent's run, not the Review. The AI usage fields
// are set once the model has answered, even when its answer failed validation:
// `aiModel` is a key of src/lib/ai/pricing.ts and `costMicroUsd` the estimated cost
// at that model's prices, in millionths of a US dollar.
model Task {
  id            String     @id @default(cuid())
  workspaceId   String
  brandId       String
  requestedById String
  type          TaskType
  status        TaskStatus @default(QUEUED)
  input         Json
  error         String?
  aiModel       String?
  inputTokens   Int?
  outputTokens  Int?
  costMicroUsd  Int?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  workspace     Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand         Brand              @relation(fields: [brandId], references: [id], onDelete: NoAction)
  requestedBy   User               @relation(fields: [requestedById], references: [id], onDelete: NoAction)
  contentAssets ContentAsset[]
  activity      ActivityLogEntry[]

  @@index([workspaceId, createdAt])
}

// One Variant written by a content Task: an editable draft, never approved directly.
// `subject` is set only for content types that have one (an Email's subject line).
// `ruleViolations` are the Brand rules its text broke when it was written, parsed by
// src/lib/brand-rules.ts: warnings for the Review and the Approver, never a block.
model ContentAsset {
  id             String   @id @default(cuid())
  taskId         String
  variant        Int
  subject        String?
  body           String
  ruleViolations Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  proposedActions ProposedAction[]

  @@unique([taskId, variant])
}

// An immutable snapshot of exactly what would be published or sent (ADR-0001). It is
// written once and never updated: no code updates it, and every material change adds a
// new row. `payload` is the canonical payload and `payloadHash` its SHA-256
// (src/lib/workflows/proposed-action-payload.ts). `ruleViolations` are the Brand rules its
// text broke when it was proposed (src/lib/brand-rules.ts): warnings shown with it, never
// part of the payload or its hash.
model ProposedAction {
  id             String   @id @default(cuid())
  workspaceId    String
  brandId        String
  contentAssetId String
  createdById    String
  payload        Json
  payloadHash    String
  ruleViolations Json     @default("[]")
  createdAt      DateTime @default(now())

  workspace    Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  brand        Brand        @relation(fields: [brandId], references: [id], onDelete: NoAction)
  contentAsset ContentAsset @relation(fields: [contentAssetId], references: [id], onDelete: NoAction)
  createdBy    User         @relation(fields: [createdById], references: [id], onDelete: NoAction)
  approval     Approval?

  @@index([workspaceId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  SUPERSEDED
}

// The human decision on one Proposed Action. It says nothing about whether the action
// ran: each attempt is an Execution. `comment` is the Approver's reason, required to
// reject (src/lib/app/approvals.ts). `resubmissionOfId` is set on an Approval that
// resubmits a Rejected one; it is unique, so a rejection is resubmitted at most once,
// and the Rejected Approval itself is never written again. `supersededById` is set, with
// the SUPERSEDED status, on an Approval replaced by a newer one after a material change
// (src/lib/app/content-assets.ts); it points to the newer Approval.
model Approval {
  id               String         @id @default(cuid())
  proposedActionId String         @unique
  status           ApprovalStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  comment          String?
  resubmissionOfId String?        @unique
  supersededById   String?        @unique
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  proposedAction ProposedAction     @relation(fields: [proposedActionId], references: [id], onDelete: Cascade)
  decidedBy      User?              @relation(fields: [decidedById], references: [id], onDelete: NoAction)
  resubmissionOf Approval?          @relation("Resubmission", fields: [resubmissionOfId], references: [id], onDelete: NoAction)
  resubmittedAs  Approval?          @relation("Resubmission")
  supersededBy   Approval?          @relation("Supersession", fields: [supersededById], references: [id], onDelete: NoAction)
  supersedes     Approval?          @relation("Supersession")
  executions     Execution[]
  activity       ActivityLogEntry[]
}

enum ExecutionStatus {
  STARTED
  SUCCEEDED
  FAILED
}

// One attempt to carry out an Approved Proposed Action; only
// src/lib/workflows/execution-service.ts writes them. Every attempt for an Approval
// shares the idempotency key derived from it, and the unique attempt number keeps two
// runs from both claiming the same attempt.
model Execution {
  id             String          @id @default(cuid())
  approvalId     String
  idempotencyKey String
  attempt        Int
  status         ExecutionStatus @default(STARTED)
  result         Json?
  error          String?
  startedAt      DateTime        @default(now())
  finishedAt     DateTime?

  approval Approval @relation(fields: [approvalId], references: [id], onDelete: Cascade)

  @@unique([approvalId, attempt])
}

enum ActivityEvent {
  BRAND_CREATED
  BRAND_UPDATED
  TASK_FAILED
  PROPOSED_ACTION_SUBMITTED
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_SUPERSEDED
  EXECUTION_SUCCEEDED
}

// Append-only: src/lib/app/activity-log.ts only ever inserts entries. NoAction keeps a
// User, Brand, Task or Approval with entries from being deleted, so no entry is ever
// rewritten; only deleting the whole Workspace removes its log. The id only grows, which
// gives a strict newest-first order even when two entries share a timestamp. A null
// actorId means the system acted, e.g. a background Task failed.
model ActivityLogEntry {
  id          Int           @id @default(autoincrement())
  workspaceId String
  actorId     String?
  event       ActivityEvent
  brandId     String?
  taskId      String?
  approvalId  String?
  details     Json
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: NoAction)
  brand     Brand?    @relation(fields: [brandId], references: [id], onDelete: NoAction)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: NoAction)
  approval  Approval? @relation(fields: [approvalId], references: [id], onDelete: NoAction)

  @@index([workspaceId, id])
}
